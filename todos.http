@baseUrl = http://localhost:8080

### Create a TODO (201). Run first to capture todoId for subsequent requests.
POST {{baseUrl}}/api/todos
Content-Type: application/json

{
  "title": "Buy milk",
  "description": "Two bottles",
  "completed": false
}

> {%
    client.test("TODO created", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });
    if (response.status === 201) {
        client.global.set("todoId", response.body.id);
    }
%}

### List all TODOs (200)
GET {{baseUrl}}/api/todos

> {%
    client.test("Response includes a trace ID", function () {
        client.assert(/^[0-9a-f]{32}$/.test(response.headers.valueOf("X-Trace-Id")),
            "Expected a 32-character trace ID");
    });
%}

### Continue a W3C trace. X-Trace-Id should match the trace ID below.
GET {{baseUrl}}/api/todos
traceparent: 00-0123456789abcdef0123456789abcdef-0123456789abcdef-01

### Get the created TODO (200)
GET {{baseUrl}}/api/todos/{{todoId}}

### Update and mark completed (200). PUT replaces all fields.
PUT {{baseUrl}}/api/todos/{{todoId}}
Content-Type: application/json

{
  "title": "Buy milk",
  "description": "Two bottles purchased",
  "completed": true
}

### Delete the created TODO (204)
DELETE {{baseUrl}}/api/todos/{{todoId}}

### Fetch the deleted TODO (404). Run after Delete.
GET {{baseUrl}}/api/todos/{{todoId}}

### Test validation: blank title (400)
POST {{baseUrl}}/api/todos
Content-Type: application/json

{
  "title": "   "
}
